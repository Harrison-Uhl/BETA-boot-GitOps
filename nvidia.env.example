# rar-chat configuration — NVIDIA NIM hosted catalog
# Copy to e.g. nvidia.env, fill in your key, then:  rar-chat nvidia.env
# Protect the real file:  chmod 600 nvidia.env  — and keep it out of git.
#
# Key:      generate at https://build.nvidia.com/settings
# Models:   catalog at  https://build.nvidia.com/  (use the full vendor/name string)
# API ref:  https://docs.api.nvidia.com/nim/reference/llm-apis

OPENAI_API_KEY=nvapi-REPLACE-ME
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Optional:
# OPENAI_SYSTEM=You are a concise assistant.
# OPENAI_INCLUDE_USAGE=1     # set 0 if a given model rejects stream_options
# OPENAI_STALL_SECS=30

# Strategy / capture (chunk 02c):
# OPENAI_RETRY_ALLOWANCE=1              # turn re-issues before failover/give-up
# OPENAI_SEND_BUCKETS=1                 # outbound admission slots (back pressure)
# OPENAI_FIRST_BYTE_BACKSTOP_SECS=120   # loose mechanical ceiling before first byte
# OPENAI_CAPTURE_DIR=./captures         # JSONL diagnostic capture (chmod 600!)
# FAILOVER_OPENAI_BASE_URL=https://api.openai.com/v1
# FAILOVER_OPENAI_MODEL=gpt-4o-mini
# FAILOVER_OPENAI_API_KEY=sk-...        # optional; primary key reused if omitted

# Clocks / concurrency / instrumentation (chunk 02d):
# OPENAI_OVERALL_DEADLINE_SECS=600      # absolute turn ceiling (anti-slowloris)
# OPENAI_THROUGHPUT_FLOOR_BPS=1         # sustained content bytes/sec floor
# OPENAI_THROUGHPUT_SUSTAINED_SECS=20   # how long below floor before escalating
# OPENAI_BUS_CAPACITY=4096              # emission channel depth (drop-on-full)
